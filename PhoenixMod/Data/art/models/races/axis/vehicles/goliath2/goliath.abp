	vehicle_wheel_travel				= 0.4,
	vehicle_acceleration_factor			=0.02,
	vehicle_gravity					= 1.6,	-- normal earth gravity = 1
	vehicle_debug_render				= 0,
	vehicle_smoothness				= 5.5,	-- the higher the smoother (minimum 1)
	vehicle_render_offsetX				= 0,	-- x offset of rendered model from wheel base center
	vehicle_render_offsetY				= 0.05,	-- y offset
	vehicle_render_offsetZ				= 0,	-- z offset
}