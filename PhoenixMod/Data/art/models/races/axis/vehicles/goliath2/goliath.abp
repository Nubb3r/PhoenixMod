model =
{
	"Goliath",
}

simvis_attributes =
{
	vehicle_physics					= 1,

	vehicle_width					= 1.0,
	vehicle_length					= 1.5,
	
	vehicle_nr_wheels				= 3,
	vehicle_spring_constant				= 0.1,		-- 0.0 is soft, 1.0 is max hardness
