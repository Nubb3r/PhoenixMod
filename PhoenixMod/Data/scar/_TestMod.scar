----------------------------------------------------------------------------------
-- CORE CHEAT LOGIC
----------------------------------------------------------------------------------

function Apply_CheatSettings(player)
    local set_resource = Player_SetResource
    local add_resource = Player_AddResource
    local set_popcap = Player_SetPopCapOverride
    local modify_prod = Modify_PlayerProductionRate
    local modify_build = Modify_EntityBuildTime
    local modify_recharge = Modify_AbilityRechargeTime
    local get_table_len = table.getn

    -- 1. Resources 
    set_resource(player, RT_Manpower, 99999)
    add_resource(player, RT_Fuel, 99999)
    add_resource(player, RT_Munition, 99999)
    add_resource(player, RT_Action, 2000)
    set_popcap(player, 9999)

    -- 2. Instant Production 
    modify_prod(player, 10000)

    -- 3. Instant Build 
    local all_building_tables = {
        testmod_table_allies_buildings,
        testmod_table_axis_buildings,
        testmod_table_cw_buildings,
        testmod_table_elite_buildings
    }
    
    for j = 1, get_table_len(all_building_tables) do
        local b_table = all_building_tables[j]
        for i = 1, get_table_len(b_table) do
            modify_build(player, b_table[i], 0.01)
        end
    end

    -- 4. Instant Ability Recharge
    local num_abilities = get_table_len(testmod_table_all_abilities)
    for i = 1, num_abilities do
        modify_recharge(player, testmod_table_all_abilities[i], 0)
    end
end

function display_mod()
    UI_SetDisplayIngameScore(true, true)
    UI_SetScoreSingle(Util_CreateLocString("Mode"), Util_CreateLocString("Test Mode") )
end

--------------------------
-- INITIALISATION
--------------------------

function Mod_OnInit()
    local playerCount = World_GetPlayerCount()
    for i = 1, playerCount do
        local player = World_GetPlayerAt(i)
        Apply_CheatSettings(player)
    end

    Rule_AddOneShot(display_mod, 0.25)
end

Scar_AddInit(Mod_OnInit)